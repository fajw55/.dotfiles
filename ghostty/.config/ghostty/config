# This is the configuration file for Ghostty.
#
#   /home/alanj/.config/ghostty/config
#
# Run `ghostty +show-config --default --docs` to view a list of
# all available config options and their default values.
#
# Additionally, each config option is also explained in detail
# on Ghostty's website, at https://ghostty.org/docs/config.
#
# RELOAD: ctrl+shift+,

shell-integration = zsh
shell-integration-features = ssh-env, no-cursor

# font
font-family = "MesloLGS NF"
font-size = 13

# cursor
cursor-style = "block"
# cursor-invert-fg-bg = true

# window
theme = light:TokyoNight Day,dark:TokyoNight Night

window-padding-x = 4
window-padding-y = 4
window-decoration = server
window-save-state = always
gtk-toolbar-style = flat
resize-overlay = never
split-preserve-zoom = navigation
split-divider-color = #BA7652

background-opacity = 0.85
background-blur = true

confirm-close-surface = false

# SSH session terminfo
shell-integration-features = ssh-env

# mouse stuff
# mouse-scroll-multiplier = 0.95

# keyboard bindings
# for list run `ghostty +list-keybinds --default`
keybind = super+control+shift+alt+arrow_down=resize_split:down,100
keybind = super+control+shift+alt+arrow_up=resize_split:up,100
keybind = super+control+shift+alt+arrow_left=resize_split:left,100
keybind = super+control+shift+alt+arrow_right=resize_split:right,100
keybind = control+shift+s=close_surface

# keybind = super+c=copy_to_clipboard
# keybind = super+v=paste_from_clipboard
