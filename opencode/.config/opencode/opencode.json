{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "./plugins/caveman/plugin.js"
  ],
  "mcp": {
    "quay": {
      "type": "local",
      "command": ["quay", "mcp"],
      "enabled": true
    },
    "azure-devops": {
      "type": "local",
      "command": ["npx", "-y", "@azure-devops/mcp", "oriflame"],
      "enabled": true
    },
    "mui-mcp": {
      "type": "local",
      "command": ["npx", "-y", "@mui/mcp@latest"],
      "enabled": true
    }
  }
}
