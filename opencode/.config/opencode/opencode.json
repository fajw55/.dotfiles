{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "./plugins/caveman/plugin.js"
  ],
  "mcp": {
    "quay": {
      "type": "local",
      "command": [
        "quay",
        "mcp"
      ],
      "enabled": true
    },
    "azure-devops": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@azure-devops/mcp",
        "oriflame"
      ],
      "enabled": true
    },
    "mui-mcp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@mui/mcp@latest"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp@latest"
      ],
      "enabled": true
    }
    // "wiki-kb": {
    //   "type": "remote",
    //   "url": "https://srch-wikikbsync.search.windows.net/knowledgebases/knowledgebase-srch-wikikbsync/mcp?api-version=2026-05-01-preview",
    //   "enabled": true,
    //   "headers": {
    //     "api-key": "{key}"
    //   }
    // }
  }
}
